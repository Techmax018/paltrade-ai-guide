# ─────────────────────────────────────────────────────────────────────────────
# PalTrade Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (Supabase or Neon connection string)
# Render: set as DATABASE_URL in service environment
# Format: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://paltrade_user:CHANGEME@db.supabase.co:5432/postgres?sslmode=require

# Server
PORT=4000
NODE_ENV=production

# Allowed origins for CORS (comma-separated)
# Local: http://localhost:8080,http://localhost:5173
# Production: https://paltrade-ai-guide.vercel.app
CORS_ORIGINS=https://paltrade-ai-guide.vercel.app

# JWT — use a 64-char random hex string
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGEME_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=24h

# MetaApi.cloud — obtain from https://app.metaapi.cloud/token
METAAPI_TOKEN=CHANGEME_METAAPI_TOKEN

# Deriv — your registered App ID (set in Vercel too for OAuth URL building)
VITE_DERIV_APP_ID=1089

# Encryption key for OAuth tokens stored in DB (AES-256 requires 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGEME_32_BYTE_HEX_KEY

# Internal shared secret for Vercel → Render server-to-server calls
PALTRADE_API_SECRET=CHANGEME_INTERNAL_SECRET
